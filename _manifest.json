{
  "manifest_version": 2,
  "id": "zhengyz233.qq-persona-manager",
  "version": "1.7.2",
  "name": "QQ 人格管理（查询 / 修改 / 优化）",
  "description": "白名单鉴权的 QQ 指令插件：/人格查询 以合并转发展示 #人设 / #行为风格 / #表达风格，每段正文最前面自带分类标签（默认仅私聊，可开启群聊开关）；/人格修改 需求 由 replyer/planner 模型判定分类后热更新 bot_config.toml；/人格优化 让模型重新分类并压缩三段人格、保持语义不变以降低 token 开销，成功后再附一张合并转发卡片回显优化后的人格（默认仅私聊，可单独开启群聊开关）。",
  "author": {
    "name": "zhengyz233",
    "url": "https://github.com/zhengyz233"
  },
  "license": "MIT",
  "changelog": "CHANGELOG.md",
  "urls": {
    "repository": "https://github.com/zhengyz233/maibot-qq-persona-manager",
    "homepage": "https://github.com/zhengyz233/maibot-qq-persona-manager",
    "documentation": "https://github.com/zhengyz233/maibot-qq-persona-manager/blob/main/README.md",
    "issues": "https://github.com/zhengyz233/maibot-qq-persona-manager/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.14.99"
  },
  "dependencies": [],
  "display": {
    "icon": {
      "type": "lucide",
      "value": "user-cog",
      "fallback": "users",
      "background": "#5B8DEF"
    }
  },
  "capabilities": [
    "send.text",
    "send.forward",
    "llm.generate",
    "config.get",
    "chat.get_all_streams"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
