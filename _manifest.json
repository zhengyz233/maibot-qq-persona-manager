{
  "manifest_version": 2,
  "id": "local.qq-persona-manager",
  "version": "1.2.0",
  "name": "QQ 人格管理（查询 / 修改）",
  "description": "白名单鉴权的 QQ 指令插件：/人格查询 以合并转发展示 #人设 / #行为风格 / #表达风格（默认仅私聊，可开启群聊开关）；/人格修改 需求 由 replyer/planner 模型判定分类后热更新 bot_config.toml。",
  "author": {
    "name": "zhengyz233",
    "url": "https://github.com/zhengyz233"
  },
  "license": "MIT",
  "changelog": "CHANGELOG.md",
  "urls": {
    "repository": "https://github.com/zhengyz233/maibot-qq-persona-manager",
    "documentation": "https://docs.mai-mai.org/plugin"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.forward",
    "llm.generate",
    "config.get",
    "chat.get_all_streams"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
