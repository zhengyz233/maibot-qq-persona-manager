# 统一用 LF，避免 Windows / Linux 之间因为换行符产生无意义的 diff
* text=auto eol=lf

*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# 二进制资源不做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary

# 让 GitHub 的语言统计不要被 README 淹没
README.md linguist-documentation
LICENSE   linguist-documentation
