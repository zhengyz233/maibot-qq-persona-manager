[plugin]
config_version = "1.0.0"

[access]
whitelist = []
deny_message = "您无权进行此类操作"
notify_on_deny = true

[scope]
query_allow_group = false
query_group_disabled_message = "暂不支持群聊使用此功能，请到插件页开启此功能群聊执行开关"
treat_unknown_scope_as_group = false

[model]
task_priority = [
    "replyer",
    "planner",
]
temperature = 0.2
max_tokens = 4096
timeout_seconds = 120.0

[message]
cat_personality = "#人设"
cat_behavior_style = "#行为风格"
cat_reply_style = "#表达风格"
label_in_content = true
need_requirement_message = "请在指令后面带上修改需求"
success_message = "人格已热更新成功"
mismatch_message = "人格热更新失败，当前需求不匹配"
error_prefix = "人格热更新失败"

[behavior]
enabled = true
dry_run = false
ignore_quoted_commands = true
backup = true
backup_keep = 20
config_path = ""
max_requirement_length = 500
